# ---------------------------------------------------------------------------
# x402-carbon — environment
# Copy to .env (never commit .env). Every value below has a working default,
# so `npm run dev` works with no configuration at all.
# ---------------------------------------------------------------------------

# Port the HTTP server listens on.
PORT=4025

# ---------------------------------------------------------------------------
# Payments — dual rail. Buyers pay in USDC on Base (EVM) or Solana; the client
# picks. These are the suite's public receive addresses: replace them with your
# own to be paid yourself.
# ---------------------------------------------------------------------------

# EVM (Base / Base Sepolia) USDC receive address
PAY_TO_ADDRESS=0x40252CFDF8B20Ed757D61ff157719F33Ec332402
# Solana USDC receive address
SOLANA_PAY_TO_ADDRESS=WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW

# EVM network: base-sepolia (testnet, default) | base (mainnet)
NETWORK=base-sepolia
# Solana network: mainnet-beta (default) | devnet
SOLANA_NETWORK=mainnet-beta

# x402 facilitator that verifies and settles payments on both rails.
FACILITATOR_URL=https://x402.org/facilitator
# Solana RPC used by the optional browser (Phantom) checkout helper.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional: override the facilitator's SOL fee-payer (sponsor) account.
# SOLANA_FEE_PAYER=

# Optional: absolute base URL used in the 402 challenge's `resource` field.
# Set this when running behind a proxy or a custom domain.
# PUBLIC_BASE_URL=https://x402-carbon.example.com

# ---------------------------------------------------------------------------
# Data sources — UK Carbon Intensity API and Open-Meteo
# Both are KEYLESS and called live. There is nothing to configure here.
# Coverage is Great Britain (National Grid ESO).
# ---------------------------------------------------------------------------
